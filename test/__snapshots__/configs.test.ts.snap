exports[`ts config (typescript + stylistic) [auto-fix] 修正可能な記法を自動修正する 1`] = `
"import { readFileSync } from "node:fs";

import type { Linter } from "eslint";

import { helper } from "./helper.js";

const config: Linter.Config = {};
const value = readFileSync("x");
const greet = (name: string): string => \`Hello, \${name}\`;
export const usedValue = value;
export const result = helper();
export const usedGreet = greet("world");
export const usedConfig = config;
if (config) {
  greet("x");
}
const pad = (): number => {
  const p = 1;

  return p;
};
export const usedPad = pad();
// block
/*
 * first
 * second
 */
"
`;


exports[`tailwind config [auto-fix] 修正可能な記法を自動修正する 1`] = `
"export const Shorthand = () => <div className="size-4">x</div>;
export const Order = () => <div className="flex items-center">x</div>;
export const Whitespace = () => <div className="flex items-center">x</div>;
export const Negative = () => <div className="m-[5px]">x</div>;
export const Arbitrary = () => <div className="mt-2">x</div>;
"
`;
